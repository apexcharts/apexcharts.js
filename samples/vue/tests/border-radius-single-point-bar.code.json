{
  "title": "Border Radius Single Point Bar",
  "externals": [],
  "files": [
    {
      "name": "App.vue",
      "language": "xml",
      "code": "<template>\n  <div>\n    <div id=\"chart\">\n      <apexchart\n        type=\"bar\"\n        height=\"200\"\n        :options=\"chartOptions\"\n        :series=\"series\"\n      ></apexchart>\n    </div>\n  </div>\n</template>\n\n<script>\nimport VueApexCharts from 'vue-apexcharts'\n\nexport default {\n  components: {\n    apexchart: VueApexCharts,\n  },\n  data: function () {\n    return {\n      series: [\n        { name: 'A', data: [1] },\n        { name: 'B', data: [3] },\n        { name: 'C', data: [3] },\n      ],\n      chartOptions: {\n        chart: {\n          type: 'bar',\n          height: 200,\n          stacked: true,\n          stackType: '100%',\n        },\n        plotOptions: {\n          bar: {\n            horizontal: true,\n            borderRadius: 10,\n            barHeight: '100%',\n          },\n        },\n        colors: ['#008FFB', '#00E396', '#FEB019'],\n        dataLabels: {\n          enabled: false,\n        },\n        stroke: {\n          width: 1,\n          colors: ['#fff'],\n        },\n        title: {\n          text: 'single-point horizontal stack: outer ends round, inner joins square (#4845)',\n          style: { fontSize: '13px', fontWeight: 500 },\n        },\n        xaxis: {\n          categories: ['Total'],\n        },\n        legend: {\n          position: 'top',\n        },\n      },\n    }\n  },\n}\n</script>\n\n<style>\n#chart {\n  max-width: 650px;\n  margin: 35px auto;\n}\n</style>\n"
    }
  ]

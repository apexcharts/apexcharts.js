{
  "title": "Border Radius Grouped Column Three Groups",
  "externals": [],
  "files": [
    {
      "name": "App.vue",
      "language": "xml",
      "code": "<template>\n  <div>\n    <div id=\"chart\">\n      <apexchart\n        type=\"bar\"\n        height=\"380\"\n        :options=\"chartOptions\"\n        :series=\"series\"\n      ></apexchart>\n    </div>\n  </div>\n</template>\n\n<script>\nimport VueApexCharts from 'vue-apexcharts'\n\nexport default {\n  components: {\n    apexchart: VueApexCharts,\n  },\n  data: function () {\n    return {\n      series: [\n        { name: 'A low', group: 'a', data: [44, 55, 41, 37] },\n        { name: 'A high', group: 'a', data: [13, 23, 20, 8] },\n        { name: 'B low', group: 'b', data: [11, 17, 15, 15] },\n        { name: 'B high', group: 'b', data: [21, 7, 25, 13] },\n        { name: 'C low', group: 'c', data: [18, 12, 22, 19] },\n        { name: 'C high', group: 'c', data: [9, 14, 11, 16] },\n      ],\n      chartOptions: {\n        chart: {\n          type: 'bar',\n          height: 380,\n          stacked: true,\n        },\n        plotOptions: {\n          bar: {\n            horizontal: false,\n            borderRadius: 10,\n            borderRadiusApplication: 'end',\n          },\n        },\n        colors: [\n          '#008FFB',\n          '#4FC3F7',\n          '#00E396',\n          '#66DA26',\n          '#FEB019',\n          '#FFC46B',\n        ],\n        dataLabels: {\n          enabled: false,\n        },\n        stroke: {\n          width: 1,\n          colors: ['#fff'],\n        },\n        title: {\n          text: 'three stacks side by side, each capped independently',\n          style: { fontSize: '13px', fontWeight: 500 },\n        },\n        xaxis: {\n          categories: ['Q1', 'Q2', 'Q3', 'Q4'],\n        },\n        legend: {\n          position: 'top',\n        },\n      },\n    }\n  },\n}\n</script>\n\n<style>\n#chart {\n  max-width: 650px;\n  margin: 35px auto;\n}\n</style>\n"
    }

{
  "title": "Raincloud Layout Variations",
  "externals": [
    "https://cdn.jsdelivr.net/npm/apexcharts/dist/features/raincloud.js"
  ],
  "files": [
    {
      "name": "App.vue",
      "language": "xml",
      "code": "<template>\n  <div>\n    <div class=\"panel\">\n      <div class=\"controls\">\n        <span class=\"label\">Layout:</span>\n        <button data-layout=\"classic\" class=\"active\">Classic raincloud</button>\n        <button data-layout=\"cloud-rain\">Cloud + rain</button>\n        <button data-layout=\"cloud-box\">Cloud + box</button>\n        <button data-layout=\"overlay\">Violin + box overlay</button>\n      </div>\n    </div>\n\n    <div id=\"chart\">\n      <apexchart\n        type=\"raincloud\"\n        height=\"420\"\n        :options=\"chartOptions\"\n        :series=\"series\"\n      ></apexchart>\n    </div>\n\n    <div class=\"panel\">\n      <div class=\"note\">\n        Every raincloud layer is its own switch on\n        <code>plotOptions.violin</code>: <code>side</code> cuts the density to a\n        half-violin, <code>box.show</code> toggles the five-number lane, and\n        <code>points.position</code> moves the raw observations into their own\n        lane or back under the density. A hidden layer hands its lane back to\n        the cloud, so <b>Cloud + rain</b> and <b>Cloud + box</b> reflow instead\n        of leaving a gap, and <b>Violin + box overlay</b> (<code\n          >side: 'both'</code\n        >) is the classic symmetric violin with the box drawn on its centerline.\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport VueApexCharts from 'vue-apexcharts'\nimport ApexCharts from 'apexcharts'\n\nimport 'apexcharts/features/raincloud'\n\n// Raw observations per group (Box-Muller Gaussian; Math.random is seeded by\n// the sample template).\nfunction sample(mean, sd, n) {\n  var points = []\n  for (var k = 0; k < n; k++) {\n    var u1 = Math.random(),\n      u2 = Math.random()\n    var g = Math.sqrt(-2 * Math.log(u1)) * Math.cos(2 * Math.PI * u2)\n    points.push(Math.round((mean + g * sd) * 10) / 10)\n  }\n  return points\n}\n\n// Each layout is a complete plotOptions.violin spec, so switching between\n// them never leaves a leaf from the previous layout behind. Hidden layers\n// hand their lane back to the cloud automatically.\nvar RAINCLOUD_LAYOUTS = {\n  classic: {\n    side: 'right',\n    box: { show: true },\n    points: { show: true, position: 'left' },\n  },\n  'cloud-rain': {\n    side: 'right',\n    box: { show: false },\n    points: { show: true, position: 'left' },\n  },\n  'cloud-box': {\n    side: 'right',\n    box: { show: true },\n    points: { show: false, position: 'left' },\n  },\n  overlay: {\n    side: 'both',\n    box: { show: true },\n    points: { show: true, position: 'center', constrainToViolin: true },\n  },\n}\n\nexport default {\ncomponents: {\napexchart: VueApexCharts,\n},\ndata: function () {\nreturn {\nseries: [\n  {\n    name: 'Measurement',\n    data: [\n      { x: 'North', points: sample(52, 9, 160) },\n      { x: 'East', points: sample(61, 6, 160) },\n      { x: 'South', points: sample(47, 12, 160) },\n    ],\n  },\n],\nchartOptions: {\nchart: {\n  id: 'raincloudVariations',\n  type: 'raincloud',\n  height: 420,\n},\ncolors: ['#14b8a6'],\ntitle: {\n  text: 'One distribution chart, four layouts',\n  align: 'left',\n},\nyaxis: {\n  title: {\n    text: 'Measurement',\n  },\n},\n},\nraincloudTimer: null,\n}\n},\nmounted: function () {\n  // The vue-apexcharts wrapper owns the render, so reach the live instance\n  // by its chart.id, then wire the same controls the vanilla build does.\n  // (RAINCLOUD_LAYOUTS lives in the shared head script.)\n  var me = this\n  me.raincloudTimer = window.setInterval(function () {\n    var chart = ApexCharts.getChartByID('raincloudVariations')\n    if (!chart) return\n    window.clearInterval(me.raincloudTimer)\n\n    var buttons = Array.prototype.slice.call(\n      document.querySelectorAll('.controls button[data-layout]')\n    )\n    buttons.forEach(function (btn) {\n      btn.addEventListener('click', function () {\n        buttons.forEach(function (b) { b.classList.remove('active') })\n        btn.classList.add('active')\n        chart.updateOptions({\n          plotOptions: { violin: RAINCLOUD_LAYOUTS[btn.getAttribute('data-layout')] },\n        })\n      })\n    })\n  }, 50)\n},\nbeforeDestroy: function () {\n  window.clearInterval(this.raincloudTimer)\n},,\n}\n</script>\n\n<style>\n#chart {\n  max-width: 820px;\n  margin: 12px auto 4px;\n}\n.panel {\n  max-width: 820px;\n  margin: 14px auto;\n  font-family: sans-serif;\n}\n.controls {\n  display: flex;\n  gap: 8px;\n  align-items: center;\n  flex-wrap: wrap;\n  margin-bottom: 6px;\n}\n.controls .label {\n  font-size: 13px;\n  color: #556;\n  margin-right: 2px;\n}\n.controls button {\n  padding: 6px 12px;\n  cursor: pointer;\n  border: 1px solid #d3d8e3;\n  background: #fff;\n  border-radius: 6px;\n  font-size: 13px;\n}\n.controls button.active {\n  border-color: #14b8a6;\n  color: #0f766e;\n  background: #f0fdfa;\n  font-weight: 600;\n}\n.note {\n  background: #f0fdfa;\n  border-left: 3px solid #14b8a6;\n  padding: 11px 15px;\n  font-size: 13px;\n  color: #234;\n  border-radius: 2px;\n  line-height: 1.6;\n}\n.note code {\n  background: #c7f0ea;\n  padding: 1px 5px;\n  border-radius: 3px;\n}\n</style>\n"
    }
  ]
}